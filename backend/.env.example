# Copie para .env na RAIZ DO REPOSITORIO (nao aqui dentro de backend/).
#
# A raiz e onde o ai-core e o ai-memory-rag procuram, entao um unico .env
# serve para as tres partes.

# Chave do Gemini. Sem ela o backend SOBE do mesmo jeito: o chat usa um agente
# mock que pergunta o proximo campo faltante, o RAG cai no embedder lexical e o
# resumo do corretor usa heuristica. Bom para desenvolver sem gastar cota.
GEMINI_API_KEY=

# Modelo usado pelas DUAS metades do sistema: o agente da Parte 1 e o LLM da
# Parte 2 leem esta mesma variavel. Fixe um id em vez de confiar no padrao do
# codigo, porque a cota do Gemini e por modelo: com cada parte num modelo
# diferente, o projeto gasta duas cotas e o chat pode morrer de 429 enquanto o
# resumo do corretor continua funcionando, sem nada na tela explicando.
#
# Verificados neste projeto: gemini-2.5-flash (padrao) e gemini-3.6-flash.
GEMINI_MODEL=gemini-2.5-flash

# Banco. Padrao: SQLite em backend/data/app.db (criado sozinho).
# Para Postgres: postgresql+psycopg://user:senha@localhost:5432/sdr
DATABASE_URL=sqlite:///./data/app.db

# Origens liberadas no CORS, separadas por virgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Job de follow-up: retoma sozinho quem parou de responder.
#
# Ligado. Ele so gasta LLM quando ha lead em silencio ha 48h+ com consentimento,
# entao numa base de teste recem-criada ele acorda, nao acha ninguem e dorme de
# novo, sem custo. Se for deixar rodando dias com chave de verdade, olhe o
# consumo: um ciclo custa uma chamada por lead retomado.
FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_MINUTES=30

# Popular a base de imoveis no primeiro start, a partir de
# shared/data/imoveis.json (a mesma base que o RAG indexa).
SEED_ON_STARTUP=true
SEED_LIMIT=0
