# URL do backend (Parte 3). Padrao ja aponta para o uvicorn local.
VITE_API_URL=http://localhost:8000

# Mostra ou esconde as abas do corretor (Dashboard, Agenda, Imoveis).
#
# O painel e o chat sao a mesma aplicacao, no mesmo endereco e sem login: com
# as abas visiveis, quem abre o chat chega em um clique ao nome, ao telefone e
# a conversa de todos os outros leads. Numa demo local isso e inofensivo, e o
# padrao e `true` para a banca navegar sem configurar nada. Em qualquer lugar
# acessivel por terceiros, `false`.
#
# Isto ESCONDE a navegacao; nao e autenticacao. As rotas continuam existindo.
VITE_MODO_CORRETOR=true
