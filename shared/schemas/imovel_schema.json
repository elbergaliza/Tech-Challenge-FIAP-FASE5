{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Property",
  "description": "Documento de imovel da base simulada do Agente SDR Imobiliario. Gerado por ai-memory-rag/scripts/generate_properties.py. Dados 100% sinteticos.",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "deal_type",
    "property_type",
    "price",
    "bedrooms",
    "bathrooms",
    "parking",
    "area_m2",
    "neighborhood",
    "zone",
    "city",
    "lat",
    "lon",
    "features",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IMV-[0-9]{4}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "SALE",
        "RENTAL"
      ]
    },
    "property_type": {
      "type": "string",
      "enum": [
        "APARTMENT",
        "PENTHOUSE",
        "HOUSE",
        "STUDIO",
        "COMMERCIAL"
      ]
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "valor de venda ou aluguel mensal, conforme deal_type"
    },
    "condo_fee": {
      "type": "number",
      "minimum": 0
    },
    "property_tax": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "suites": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "integer",
      "minimum": 1
    },
    "parking": {
      "type": "integer",
      "minimum": 0
    },
    "area_m2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "neighborhood": {
      "type": "string",
      "enum": [
        "Barra",
        "Botafogo",
        "Centro",
        "Copacabana",
        "Flamengo",
        "Glória",
        "Gávea",
        "Ipanema",
        "Jacarepaguá",
        "Lagoa",
        "Lapa",
        "Leblon",
        "Méier",
        "Niterói",
        "Recreio",
        "Santa Teresa",
        "Saúde",
        "Tijuca",
        "Vidigal",
        "Vila Isabel"
      ]
    },
    "zone": {
      "type": "string",
      "enum": [
        "Centro",
        "Niterói",
        "Zona Norte",
        "Zona Oeste",
        "Zona Sul"
      ]
    },
    "city": {
      "type": "string"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepts_financing": {
      "type": "boolean"
    },
    "annual_yield_pct": {
      "type": [
        "number",
        "null"
      ],
      "description": "rentabilidade anual estimada; null quando deal_type e RENTAL"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "RESERVED",
        "SOLD"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  }
}